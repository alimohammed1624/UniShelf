# PostgreSQL
POSTGRES_USER=unishelf
POSTGRES_PASSWORD=unishelf_password
POSTGRES_DB=unishelf_db
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_NAME=unishelf-uploads
MINIO_CONSOLE_URL=http://localhost:8000/minio-console

# App
DEBUG=1

# Organisation scope
# Comma-separated email domains allowed to register. One UniShelf deployment
# serves one organisation, and this is what binds it to that organisation.
# Matching is on the exact domain, so list any subdomains you also accept:
#   ALLOWED_EMAIL_DOMAINS=acme.com,mail.acme.com
# Leave blank to run an open instance that accepts any domain.
ALLOWED_EMAIL_DOMAINS=unishelf.app

# Gemini (AI tag suggestions)
# Optional — leave blank to disable. Suggestions then fall back to popular tags.
GEMINI_API_KEY=

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
